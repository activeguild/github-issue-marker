{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "version": "1.3.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_name__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "contextMenus",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "overview.html",
  "commands": {
    "next-block": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "__MSG_cmdNextBlock__"
    },
    "toggle-check": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "__MSG_cmdToggleCheck__"
    },
    "toggle-cross": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "__MSG_cmdToggleCross__"
    },
    "write-note": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "__MSG_cmdWriteNote__"
    },
    "prev-block": {
      "description": "__MSG_cmdPrevBlock__"
    },
    "next-unread": {
      "description": "__MSG_cmdNextUnread__"
    },
    "compose-reply": {
      "description": "__MSG_menuComposeReply__"
    }
  }
}
